# Chance — variables backend (Lot E scaffold)
# Copier vers .env si besoin. La démo Expo tourne SANS ces valeurs.
# Ne jamais committer de vraies clés. Pas de mode Stripe live.

# Supabase (projet TEST / staging)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Stripe — clé publishable TEST uniquement (pk_test_…)
# Interdit : pk_live_ / sk_live_ / charges réelles
STRIPE_PUBLISHABLE_KEY_TEST=

# Quand le bundler Expo lira .env, dupliquer avec préfixe public :
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
# EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY_TEST=
